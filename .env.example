# PM SETU AP Backend — example environment file.
# Copy to .env and fill in real values. Never commit the real .env.

# Server
PORT=3000
# NODE_ENV=development   # development | production | test

# Database (used by the Prisma driver adapter and prisma.config.ts)
DATABASE_URL="postgresql://user:password@localhost:5432/pm_setu?schema=public"

# CORS — comma-separated origins, or * for all
# CORS_ORIGIN=http://localhost:5173

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_ACCESS_SECRET=
# JWT_ACCESS_EXPIRES_IN=8h
# ACCOUNT_LOCK_MAX_ATTEMPTS=5
# ACCOUNT_LOCK_MINUTES=15

# Logging — debug | info | warn | error
# LOG_LEVEL=debug

# Rate limiting
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_MAX=300
# RATE_LIMIT_AUTH_MAX=20

# Uploads
# UPLOAD_DIR=uploads
# UPLOAD_MAX_FILE_SIZE_MB=10

# ─────────────────────────────────────────────────────────────────────────────
# DEMO / TEST DATA
# ─────────────────────────────────────────────────────────────────────────────
# The PM SETU tables ship EMPTY on purpose: the specification forbids
# publishing invented clusters, partners, investment figures or officer names
# as departmental content. The database is populated on demand for local
# development only:
#
#   npm run db:seed:demo    # load fictional data (refuses to run in production)
#   npm run db:seed:wipe    # remove every seeded row
#
# Seeded rows carry is_sample = TRUE and a "(DEMO)" title prefix, so demo data
# is identifiable in the UI, greppable in the database, and removable with a
# single indexed DELETE. Nothing the admin console creates sets that flag.
# ─────────────────────────────────────────────────────────────────────────────
